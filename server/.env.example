# TADASHI Backend Environment Configuration
PORT=3000
HOST=127.0.0.1
NODE_ENV=development

# PostgreSQL Connection String (optional: memory store used if unset)
DATABASE_URL=postgresql://tadashi:secret_password@localhost:5432/tadashi_lifeos

# HMAC Secret for Session Tokens (generate a secure random 32+ char string in production)
SESSION_SECRET=tadashi_dev_session_secret_change_in_prod

# Allowed CORS Origins (comma-separated, include your production Vercel frontend URL)
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ============================================================
# FREE-ONLY DUAL-GATEWAY AI ROUTER CONFIGURATION
# Primary Gateway: OmniRoute | Secondary Gateway: FreeLLMAPI
# Zero surprise spending: paid models strictly blocked.
# Secrets remain 100% server-side.
# ============================================================
AI_ROUTING_MODE=free_only
AI_PAID_MODELS_BLOCKED=true
AI_REQUEST_TIMEOUT_MS=45000
AI_MAX_FAILOVER_ATTEMPTS=1

# Primary AI Gateway — OmniRoute
OMNIROUTE_BASE_URL=
OMNIROUTE_API_KEY=
OMNIROUTE_MODEL=meta-llama/llama-3.2-3b-instruct:free

# Secondary AI Gateway — FreeLLMAPI (Failover only)
FREELLMAPI_BASE_URL=
FREELLMAPI_API_KEY=
FREELLMAPI_MODEL=meta-llama/llama-3.2-3b-instruct:free

# Strict Free-Tier Model Allowlist (comma-separated, wildcard supported: e.g. qwen/*)
AI_FREE_MODEL_ALLOWLIST=meta-llama/llama-3.2-3b-instruct:free,meta-llama/llama-3.1-8b-instruct:free,gemini-2.0-flash-exp:free,gemini-2.5-flash,mistralai/mistral-7b-instruct:free,qwen/qwen-2.5-7b-instruct:free
