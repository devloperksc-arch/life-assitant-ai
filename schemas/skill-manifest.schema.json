{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tadashi.local/schemas/skill-manifest.schema.json",
  "title": "TADASHI Skill Manifest",
  "description": "Draft contract for a versioned, permissioned TADASHI skill. Validate in code before installation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "version", "description", "runtime", "permissions", "network", "inputs", "outputs", "risk", "requiresApproval", "tests"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 80},
    "name": {"type": "string", "minLength": 1, "maxLength": 120},
    "version": {"type": "string", "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?$"},
    "description": {"type": "string", "minLength": 1, "maxLength": 1000},
    "entrypoint": {"type": "string", "maxLength": 240},
    "runtime": {"enum": ["isolated-worker", "wasm", "approved-local-adapter"]},
    "permissions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 3, "maxLength": 160}},
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "allowed_domains"],
      "properties": {
        "enabled": {"type": "boolean"},
        "allowed_domains": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^(?:[a-z0-9](?:[a-z0-9-]*[a-z0-9])?\\.)*[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"}}
      }
    },
    "secrets": {"type": "array", "maxItems": 0, "items": {"type": "string"}, "description": "Skills must not receive raw secrets. Use approved scoped service capabilities instead."},
    "inputs": {"type": "array", "items": {"$ref": "#/$defs/ioField"}},
    "outputs": {"type": "array", "items": {"$ref": "#/$defs/ioField"}},
    "risk": {"enum": ["read", "reversible_write", "external_effect", "destructive"]},
    "requiresApproval": {"const": true},
    "resourceLimits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 900},
        "memoryMb": {"type": "integer", "minimum": 64, "maximum": 4096},
        "maxOutputBytes": {"type": "integer", "minimum": 1024, "maximum": 104857600}
      }
    },
    "tests": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "maxLength": 240}},
    "artifactDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "source": {"type": "string", "maxLength": 500}
  },
  "$defs": {
    "ioField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type"],
      "properties": {
        "name": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"},
        "type": {"enum": ["string", "number", "integer", "boolean", "string[]", "fileIds[]", "object"]},
        "description": {"type": "string", "maxLength": 500},
        "required": {"type": "boolean", "default": true}
      }
    }
  }
}
