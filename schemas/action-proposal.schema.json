{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tadashi.local/schemas/action-proposal.schema.json",
  "title": "TADASHI Action Proposal",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "kind", "status", "version", "createdAt", "expiresAt", "resourceVersions", "summary", "changes", "requiredScopes", "risk"],
  "properties": {
    "id": {"type": "string", "minLength": 1, "maxLength": 128},
    "kind": {"type": "string", "minLength": 1, "maxLength": 120},
    "status": {"enum": ["draft", "awaiting_approval", "approved", "rejected", "executing", "completed", "failed", "expired", "cancelled"]},
    "version": {"type": "integer", "minimum": 1},
    "createdAt": {"type": "string", "format": "date-time"},
    "expiresAt": {"type": "string", "format": "date-time"},
    "resourceVersions": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "summary": {"type": "string", "minLength": 1, "maxLength": 1000},
    "reasoningSummary": {"type": "string", "maxLength": 1500},
    "changes": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "requiredScopes": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "risk": {"enum": ["read", "reversible_write", "external_effect", "destructive"]}
  }
}
