# TEMPLATE ONLY. Copy to an ignored local .env file or populate your hosting secret manager.
# Never commit real values. Never paste secrets into Antigravity chat.

# TADASHI API
NODE_ENV=development
PORT=3000
PUBLIC_APP_ORIGIN=http://localhost:5500
PUBLIC_API_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# PostgreSQL (use a disposable local/test database for development)
DATABASE_URL=

# Auth provider (choose one; names are placeholders until selected)
AUTH_ISSUER_URL=
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=
AUTH_AUDIENCE=
SESSION_SECRET=

# AI gateway: TADASHI backend only
LITELLM_BASE_URL=http://127.0.0.1:4000
LITELLM_RUNTIME_API_KEY=
LITELLM_MASTER_KEY=

# Example hosted providers (add only the provider(s) actually selected)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_CLOUD_API_KEY=

# Model IDs are configuration; verify availability and tool-call capability before enabling.
TADASHI_DEFAULT_CLOUD_MODEL=
TADASHI_DEFAULT_LOCAL_MODEL=

# Local PC Agent (keep this local/private; do not bind public)
OLLAMA_BASE_URL=http://127.0.0.1:11434
PC_AGENT_DEVICE_ID=
PC_AGENT_TOKEN=

# Scheduling/integrations
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# Worker and operational controls
WORKER_ENABLED=false
JOB_QUEUE_URL=
MAX_MODEL_SPEND_USD_MONTHLY=
MAX_MODEL_TOKENS_PER_TURN=8192
MAX_TOOL_EXECUTION_SECONDS=30

# Observability (optional; configure redaction before enabling)
ERROR_REPORTING_DSN=
METRICS_ENDPOINT=
